# Корень репозитория — не сайт (Д35). Если он по ошибке окажется в каталоге
# сайта на Apache (так было 05.10.2026), сервер ничего из него не отдаст.
# Сайт выгружается только из build/site/production/ — там свой .htaccess.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
