{
  "permissions": {
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(keytool *)",
      "Bash(apksigner *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
