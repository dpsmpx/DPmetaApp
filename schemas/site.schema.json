{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site/v1",
  "title": "Сайт",
  "description": "data/website/site.yaml (Д21, Д32)",
  "type": "object",
  "required": [
    "schema",
    "canonical_base",
    "languages",
    "environments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "site/v1"
    },
    "title": {
      "type": "object"
    },
    "real_name": {
      "type": "boolean",
      "description": "Д37: имя автора (AU-NAME) на сайте; false — только dpsmpx, сборка проверяет каждый файл"
    },
    "canonical_base": {
      "type": "string",
      "pattern": "^https://"
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "ru",
          "en"
        ]
      }
    },
    "environments": {
      "type": "object",
      "required": [
        "staging",
        "production"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "base_url",
          "noindex"
        ],
        "properties": {
          "base_url": {
            "type": "string"
          },
          "noindex": {
            "type": "boolean"
          },
          "drafts": {
            "type": "boolean"
          },
          "deploy": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "rsync",
                  "command"
                ]
              },
              "target_ref": {
                "type": "string",
                "pattern": "^CS_(DEV|STAGING|PROD)_[A-Z0-9_]+$"
              },
              "guard_suffix": {
                "type": "string"
              },
              "protect": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "live": {
            "type": "boolean",
            "description": "Д34: выгрузка разрешена только после слов автора «сайт готов»"
          }
        }
      }
    },
    "home": {
      "type": "object"
    },
    "og_default": {
      "type": [
        "object",
        "null"
      ]
    },
    "hosting": {
      "enum": [
        "beget",
        "cloudflare_pages",
        "netlify"
      ],
      "description": "Хостинг рабочего сайта (Д35): какой файл заголовков писать"
    }
  }
}
