{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "dpvis-model/1",
 "title": "DPvisualisation: модель экосистемы, версия 1",
 "description": "Узлы и потоки экосистемы dpsmpx. Описание полей — docs/FORMATS.md. В пределах версии поля только добавляются; читатель игнорирует незнакомые поля (D-07).",
 "type": "object",
 "required": ["schema", "title", "as_of", "timezone", "source", "allow", "catalog", "layers", "nodes", "flows"],
 "properties": {
  "schema": {"const": "dpvis-model/1"},
  "title": {"type": "string", "minLength": 1},
  "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "timezone": {"type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$"},
  "source": {
   "type": "object",
   "required": ["path", "sha256"],
   "properties": {
    "path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  },
  "sources": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
  "allow": {
   "type": "object",
   "required": ["hosts"],
   "properties": {"hosts": {"type": "array", "items": {"type": "string"}}}
  },
  "registry": {
   "type": "object",
   "required": ["node", "path", "contracts"],
   "properties": {
    "node": {"$ref": "#/$defs/id"},
    "path": {"type": "string"},
    "contracts": {"type": "string"},
    "exclude": {"type": "array", "items": {"type": "string"}},
    "exclude_contracts": {"type": "array", "items": {"type": "string"}},
    "exclude_reason": {"type": "string", "minLength": 1}
   }
  },
  "catalog": {
   "type": "object",
   "required": ["node_kinds", "flow_kinds", "drivers", "statuses", "transports", "visibility", "groups"],
   "properties": {
    "node_kinds": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "flow_kinds": {"type": "array", "items": {"$ref": "#/$defs/flow_kind"}},
    "drivers": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "statuses": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "transports": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "visibility": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/label"}}
   }
  },
  "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/label"}},
  "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
  "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}}
 },
 "$defs": {
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
  "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:\\S"},
  "label": {
   "type": "object",
   "required": ["id", "name"],
   "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
  },
  "flow_kind": {
   "type": "object",
   "required": ["id", "name", "driver"],
   "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "driver": {"enum": ["human", "ai", "check", "data"]}
   }
  },
  "status": {"enum": ["active", "planned", "blocked", "off"]},
  "probe": {
   "type": "object",
   "required": ["url", "expect", "headers"],
   "properties": {
    "url": {"type": "string", "pattern": "^https?://"},
    "expect": {"type": "integer", "minimum": 100, "maximum": 599},
    "headers": {"type": "array", "items": {"type": "string"}}
   }
  },
  "node": {
   "type": "object",
   "required": ["id", "name", "kind", "layer", "role", "status", "visibility", "refs"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["repo", "actor", "service", "device", "platform", "upstream"]},
    "layer": {"type": "string"},
    "role": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "visibility": {"enum": ["public", "private", "undisclosed"]},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "clone": {"type": "string"},
    "group": {"enum": ["control", "core", "support", "new", "periphery"]},
    "stage": {"type": "string"},
    "note": {"type": "string"},
    "row": {"type": "number"},
    "public_role": {"type": "string", "minLength": 1},
    "public_stage": {"type": "string", "minLength": 1},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}}
   }
  },
  "signal": {
   "type": "object",
   "required": ["type"],
   "properties": {
    "type": {"enum": ["git-commits", "git-path", "probe"]},
    "repo": {"$ref": "#/$defs/id"},
    "who": {"enum": ["ai", "human", "merge", "any"]},
    "scope": {"enum": ["main", "all"]},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node": {"$ref": "#/$defs/id"}
   }
  },
  "flow": {
   "type": "object",
   "required": ["id", "from", "to", "kind", "driver", "status", "what", "transport", "bidirectional", "contracts", "refs"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "from": {"$ref": "#/$defs/id"},
    "to": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["work", "decision", "knowledge", "facts", "metrics", "format", "delivery", "check", "read", "deploy", "publish", "service", "notify", "build", "host"]},
    "driver": {"enum": ["human", "ai", "check", "data"]},
    "status": {"$ref": "#/$defs/status"},
    "what": {"type": "string", "minLength": 1},
    "transport": {"enum": ["git", "clone", "copy", "http", "rsync", "intent", "push", "api", "manual", "knowledge"]},
    "bidirectional": {"type": "boolean"},
    "contracts": {"type": "array", "items": {"type": "string", "pattern": "^DPmeta:C-\\d{2}$"}},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "trigger": {"type": "string"},
    "format": {"type": "string"},
    "note": {"type": "string"},
    "via": {"$ref": "#/$defs/id"},
    "public_what": {"type": "string", "minLength": 1},
    "signal": {"$ref": "#/$defs/signal"}
   }
  }
 }
}
