#!/usr/bin/env python3
"""DP Verify — точка входа (ТЗ, §9).

Перезапускает себя как `python3 -X utf8 -I -B` (F-02): кодировка не зависит
от локали, PYTHONPATH и пользовательские site-packages не влияют, байткод
на диск не пишется (V-06). Синтаксис файла — совместимый со старыми Python,
чтобы проверка версии успела сказать понятное.
"""
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("dpv: нужен Python 3.11 или новее (V-01), а это %d.%d\n" % sys.version_info[:2])
    sys.exit(2)

if not (sys.flags.utf8_mode and sys.flags.isolated and sys.dont_write_bytecode):
    if sys.executable and os.environ.get("DPV_REEXEC") != "1":
        os.environ["DPV_REEXEC"] = "1"
        os.execv(sys.executable, [sys.executable, "-X", "utf8", "-I", "-B",
                                  os.path.realpath(__file__)] + sys.argv[1:])
os.environ.pop("DPV_REEXEC", None)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

try:
    from dpverify.cli import main
except Exception:  # noqa: BLE001 — копия не загружается: сбой инструмента, код 3 (V-10)
    import traceback
    sys.stderr.write("dpv: копия DP Verify не загружается (сбой инструмента, а не кода):\n"
                     + traceback.format_exc())
    sys.exit(3)

sys.exit(main())
