{
  "format": "dppass.config",
  "format_version": 1,
  "name": "Test config",
  "profiles": [
    {
      "id": "trojan-ws",
      "name": "Trojan WS",
      "server": "198.51.100.20",
      "port": 443,
      "protocol": {
        "type": "trojan",
        "password": "test-password-1"
      },
      "transport": {
        "type": "websocket",
        "path": "/ws",
        "host": "ws.example.org"
