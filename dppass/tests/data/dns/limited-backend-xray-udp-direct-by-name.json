{
  "format": "dppass.config",
  "format_version": 1,
  "name": "Direct UDP DNS server given by name",
  "profiles": [
    {
      "id": "reality-1",
      "name": "Reality 1",
      "server": "203.0.113.10",
      "port": 443,
      "protocol": {
        "type": "vless",
        "id": "00000000-0000-4000-8000-000000000001",
        "flow": "vision"
      },
      "transport": {
        "type": "tcp"
      },
      "security": {
        "type": "reality",
        "server_name": "www.example.com",
        "public_key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
        "short_id": "01234567"
      }
    }
  ],
  "routing": {
    "default": "proxy"
  },
  "dns": {
    "servers": [
      {
        "id": "remote",
        "type": "https",
        "url": "https://dns.example.net/dns-query",
        "route": "tunnel"
      },
      {
        "id": "domestic",
        "type": "udp",
        "address": "dns.example.ru:53",
        "route": "direct"
      }
    ],
    "default": "remote",
    "rules": [
      {
        "domain_suffix": [
          "example.ru"
        ],
        "server": "domestic"
      }
    ]
  }
}
