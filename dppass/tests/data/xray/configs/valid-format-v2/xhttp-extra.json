{
  "log": {
    "loglevel": "none",
    "dnsLog": false
  },
  "dns": {
    "tag": "dppass:dns",
    "servers": [
      {
        "address": "https://dns.example.net/dns-query",
        "tag": "dns:remote",
        "finalQuery": true
      }
    ],
    "queryStrategy": "UseIP",
    "disableFallbackIfMatch": true
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ruleTag": "dppass:dns-hijack",
        "inboundTag": [
          "tun-in"
        ],
        "ip": [
          "172.19.0.2"
        ],
        "port": "53",
        "outboundTag": "dns-out"
      },
      {
        "ruleTag": "dppass:dns:remote",
        "inboundTag": [
          "dns:remote"
        ],
        "outboundTag": "proxy"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {
        "name": "dppass0",
        "mtu": 1500
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "address": "203.0.113.26",
        "port": 443,
        "id": "00000000-0000-4000-8000-000000000026",
        "encryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/x",
          "mode": "auto",
          "xPaddingBytes": "100-1000",
          "scMaxEachPostBytes": "1000000",
          "scMinPostsIntervalMs": "10-50",
          "noGRPCHeader": true,
          "xmux": {
            "maxConcurrency": "16-32",
            "cMaxReuseTimes": "64-128",
            "hMaxRequestTimes": "600-900",
            "hMaxReusableSecs": "1800-3000",
            "hKeepAlivePeriod": 30
          }
        },
        "security": "reality",
        "realitySettings": {
          "serverName": "www.example.com",
          "password": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
          "shortId": "01234567",
          "fingerprint": "random"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "hijack",
            "qType": "1,28"
          },
          {
            "action": "return",
            "rCode": 0
          }
        ]
      }
    }
  ],
  "stats": {},
  "policy": {
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  }
}
