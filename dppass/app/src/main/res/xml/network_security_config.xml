<?xml version="1.0" encoding="utf-8"?>
<!-- Открытый HTTP запрещён для всего приложения; доверие — только системным CA. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
