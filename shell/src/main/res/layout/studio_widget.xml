<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews рисуется в лаунчере, без окна Activity. Собственный фон необходим;
     Lint ошибочно предполагает фон окна Theme.Holo и сообщает Overdraw. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@color/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center_vertical" android:text="@string/widget_title" android:textColor="@color/widget_foreground" android:textSize="16sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="48dp"
            android:minWidth="48dp" android:paddingHorizontal="8dp" android:gravity="center"
            android:text="@string/widget_refresh" android:contentDescription="@string/widget_refresh_description" android:textColor="@color/widget_action" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_projects" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:textColor="@color/widget_foreground" android:textSize="14sp" />
    <TextView android:id="@+id/widget_project_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/widget_ai_counts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_foreground" android:textSize="14sp" />
    <TextView android:id="@+id/widget_health" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/widget_read_at" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_secondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_ide" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/widget_ide" android:textColor="@color/widget_action" android:textSize="14sp" />
        <TextView android:id="@+id/widget_ai" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/widget_ai" android:textColor="@color/widget_action" android:textSize="14sp" />
        <TextView android:id="@+id/widget_check" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/widget_check" android:textColor="@color/widget_action" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
