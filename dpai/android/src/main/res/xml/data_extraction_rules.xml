<?xml version="1.0" encoding="utf-8"?>
<!--
    Ничего не переносится — ни в облачную копию, ни на новое устройство (аудит
    безопасности 1 ноября 2026, A-10): с targetSdk 31+ allowBackup="false" не
    отключает перенос между устройствами, а в данных — токен канала dpai,
    known_hosts, корневая система Linux со входами Claude. Перенос настроек —
    только копией без секретов (D-25, D-51).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
