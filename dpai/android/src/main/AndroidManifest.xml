<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SSH к targets из контроллера приложения (D-35). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- «Доступ ко всем файлам» (D-99): переключатель вкладки «Файлы», по умолчанию выключен; хранилище —
         в Linux приложения. ScopedStorage: приложение личное и не публикуется в магазинах (D-74). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Такт контроллера при выключенном экране — частичный wakelock службы (D-39). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Проверка обновлений окружения переживает перезагрузку (D-197); у приложения оно уже есть (DPmetaApp:D-149). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Уведомления контроллера (D-36); на Android 13+ разрешение спрашивается при запуске. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Контроллер в фоне — служба переднего плана (D-36). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Окно запроса поверх приложений (D-44): только если человек включил его и дал разрешение в настройках. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- DNS сети телефона для Linux-среды в приложении (D-90): только чтение состояния сети, выдаётся при установке. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Подтверждение действия уровня 2 PIN устройства или отпечатком (DPmetaApp:D-80): комментарий к PR. Обычное разрешение,
         выдаётся при установке; в приложении DPmetaApp оно уже есть у входа (DPmetaApp:D-59). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Установка собранного APK (D-157): каждую установку подтверждает человек в окне Android. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DpaiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dpai">
        <!-- Поворот, тема, размер окна — без пересоздания: экраны на Compose перерисовываются сами, а диалоги
             и введённое (в том числе полученный ключ хоста) не теряются (ревью 8 октября 2026, A-39). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Вход из своих уведомлений (ссылка на задачу, подтверждение опасного ответа, D-44):
             не экспортируется — чужое приложение этим путём экран не откроет. -->
        <activity-alias
            android:name=".InternalEntry"
            android:exported="false"
            android:targetActivity=".MainActivity" />
        <!-- Свой терминал к target по SSH (D-71): только из своего экрана; поворот и клавиатура — без пересоздания. -->
        <activity
            android:name=".TerminalActivity"
            android:theme="@style/Theme.Dpai.Terminal"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <!-- Ответы на запросы — только через PendingIntent своего уведомления (D-44). -->
        <!-- Проверка обновлений окружения раз в сутки (D-197): Wi-Fi и зарядка; только чтение. -->
        <service
            android:name=".EnvUpdatesJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".RequestReceiver"
            android:exported="false" />
        <!-- Диск приложения (D-96): корень системного выбора файлов; пока закрыт, корня нет.
             Доступ только через системный выбор: MANAGE_DOCUMENTS есть лишь у системы. -->
        <provider
            android:name=".AppDiskProvider"
            android:authorities="${applicationId}.disk"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- «Закрыть» диск из уведомления — только через PendingIntent своего уведомления. -->
        <receiver
            android:name=".AppDiskCloseReceiver"
            android:exported="false" />
        <!-- Служба своего терминала (терминал:A-1): держит процесс, пока открыты вкладки. -->
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Открытые вкладки своего терминала: SSH-сеансы к своим targets и оболочка Linux-среды приложения" />
        </service>
        <service
            android:name=".ControllerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Опрос агентов на своих execution targets по SSH и уведомления о задачах" />
        </service>
    </application>
</manifest>
