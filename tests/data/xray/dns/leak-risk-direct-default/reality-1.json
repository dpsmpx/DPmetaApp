{
  "log": {
    "loglevel": "none",
    "dnsLog": false
  },
  "dns": {
    "tag": "dppass:dns",
    "servers": [
      {
        "address": "localhost",
        "tag": "dns:local",
        "domains": [
          "domain:example.ru"
        ],
        "skipFallback": true,
        "finalQuery": true
      },
      {
        "address": "localhost",
        "tag": "dns:local",
        "finalQuery": true
      }
    ],
    "queryStrategy": "UseIP",
    "disableFallbackIfMatch": true
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ruleTag": "dppass:dns-hijack",
        "inboundTag": [
          "tun-in"
        ],
        "ip": [
          "172.19.0.2"
        ],
        "port": "53",
        "outboundTag": "dns-out"
      },
      {
        "ruleTag": "dppass:dns:remote",
        "inboundTag": [
          "dns:remote"
        ],
        "outboundTag": "proxy"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {
        "mtu": 1500
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "address": "203.0.113.10",
        "port": 443,
        "id": "00000000-0000-4000-8000-000000000001",
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "serverName": "www.example.com",
          "password": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
          "shortId": "01234567",
          "fingerprint": "chrome"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "hijack",
            "qType": "1,28"
          },
          {
            "action": "return",
            "rCode": 0
          }
        ]
      }
    }
  ]
}
