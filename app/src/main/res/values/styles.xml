<?xml version="1.0" encoding="utf-8"?>
<!--
  Шкала шрифтов DPpass (D-34): размеры в sp — растут с системным размером
  шрифта. Цвет текста — токены values*/colors.xml.
-->
<resources>
    <style name="Text.DPpass" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.DPpass.Headline">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Заголовок раздела над карточкой: мелкий, акцентный. -->
    <style name="Text.DPpass.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Text.DPpass.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.DPpass.Body" />

    <style name="Text.DPpass.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.DPpass.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.DPpass.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.DPpass.Mono">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
