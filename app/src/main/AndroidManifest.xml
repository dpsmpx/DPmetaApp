<?xml version="1.0" encoding="utf-8"?>
<!-- Пульт DPmetaApp (этап 3): библиотека; её активность сливается в манифест приложения
     корня :shell (D-53), подпись — у приложения. Наружу не экспортируется (ТЗ, T-03). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Клонирование под службой переднего плана (D-78): процесс не выгружается на середине клона. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Мгновенный канал (D-152): соединение с ntfy держит служба `specialUse`, пока канал включён. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Сеть вернулась — канал переподключается сразу, а не после паузы (обычное разрешение). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Тревоги пульта (F-38; D-85): Android 13+ спрашивает разрешение; без него — только лента. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Фоновое обновление пульта (D-149): задача JobScheduler переживает перезагрузку (setPersisted).
         При загрузке поднимается только включённый мгновенный канал (D-152, PushBootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Мост Termux (F-41; D-84): команды реестра и проба готовности; разрешение даёт человек. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+: видеть Termux, чтобы проверить его и послать RUN_COMMAND (D-84). -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application>
        <!-- Поворот, тема, шрифт — без пересоздания, как у «AI» и экрана входа: место, итог синхронизации
             и окно клонов не теряются (аудит UI/UX 5 ноября 2026, UX-3). -->
        <activity
            android:name="com.dpsmpx.dpmeta.app.PultActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="false" />
        <!-- Экран входа на всё приложение (D-59): только изнутри, поверх любого окна. -->
        <activity
            android:name="com.dpsmpx.dpmeta.app.LockActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="false" />
        <!-- Служба клонирования (D-78): только изнутри; держит процесс и показывает ход с «Отменить». -->
        <service
            android:name="com.dpsmpx.dpmeta.app.CloneService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Фоновое обновление пульта (D-149): запускает только система (BIND_JOB_SERVICE), снаружи не виден. -->
        <service
            android:name="com.dpsmpx.dpmeta.app.PultSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Повтор отложенного и сводка по расписанию (D-152): запускает только система. -->
        <service
            android:name="com.dpsmpx.dpmeta.app.PultNoticeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Кнопка «Отложить» (D-152): только через свой PendingIntent; снаружи не виден. -->
        <receiver
            android:name="com.dpsmpx.dpmeta.app.PultNoticeReceiver"
            android:exported="false" />
        <!-- Мгновенный канал (D-152): только изнутри; держит соединение с темой ntfy, пока включён. -->
        <service
            android:name="com.dpsmpx.dpmeta.app.PushChannelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Соединение с сервером ntfy для мгновенных уведомлений о ходах Claude Code; включается в настройках, по умолчанию выключено" />
        </service>
        <!-- Включённый канал — после загрузки и обновления приложения; только системные рассылки. -->
        <receiver
            android:name="com.dpsmpx.dpmeta.app.PushBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Слушатель уведомлений (F-57; D-155): связывает только система (BIND_NOTIFICATION_LISTENER_SERVICE),
             доступ даёт человек в настройках Android; пока выключен в приложении — всё отбрасывается. -->
        <service
            android:name="com.dpsmpx.dpmeta.app.PultListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Итог Termux (D-84): только через PendingIntent, отданный Termux с вызовом; снаружи не виден. -->
        <receiver
            android:name="com.dpsmpx.dpmeta.app.data.TermuxResultReceiver"
            android:exported="false" />
        <!-- «Поделиться» экспортом (D-67): не экспортируется, права на файл — только
             получателю одной отправки; виден только каталог экспорта в кэше. -->
        <provider
            android:name="com.dpsmpx.dpmeta.app.ExportProvider"
            android:authorities="${applicationId}.pult.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pult_export_paths" />
        </provider>
    </application>
</manifest>
