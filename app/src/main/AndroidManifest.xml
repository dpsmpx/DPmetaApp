<?xml version="1.0" encoding="utf-8"?>
<!-- Пульт DPmetaApp (этап 3): библиотека; её активность сливается в манифест приложения
     корня :shell (D-53), подпись — у приложения. Наружу не экспортируется (ТЗ, T-03). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application>
        <activity
            android:name="com.dpsmpx.dpmeta.app.PultActivity"
            android:exported="false" />
        <!-- Экран входа на всё приложение (D-59): только изнутри, поверх любого окна. -->
        <activity
            android:name="com.dpsmpx.dpmeta.app.LockActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="false" />
        <!-- «Поделиться» экспортом (D-67): не экспортируется, права на файл — только
             получателю одной отправки; виден только каталог экспорта в кэше. -->
        <provider
            android:name="com.dpsmpx.dpmeta.app.ExportProvider"
            android:authorities="${applicationId}.pult.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pult_export_paths" />
        </provider>
    </application>
</manifest>
